<script>
const directpay = "https://pay.rondamo.co.ke/api/lipa/";

document.getElementById("paymentbtn").addEventListener("click", function(e) {
    const n = document.getElementById("lmobile").value;
    const t = document.getElementById("errorphone");
    const a = document.getElementById("invoicen").value;
    const r = document.getElementById("Amount").value;
    const o = document.getElementById("paymentbtn");
    const l = document.getElementById("errorphonegroup");
    const i = document.getElementById("errordiv");

    if (n === "") {
        t.innerHTML = "Please fill the phone field";
        l.classList.add("has-error", "has-feedback");
    } else {
        o.innerHTML = "Submitting. Please wait...";

        // Prepare data for POST
        const formData = new URLSearchParams();
        formData.append('phone', n);
        formData.append('paydirect', 'mpesa');
        formData.append('mehome', a);
        formData.append('memount', r);

        fetch(directpay, {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: formData
        })
        .then(response => response.text())
        .then(data => {
            const result = data.trim();
            console.log(result);

            // Wait 5 seconds before updating UI (Replaces sleep)
            setTimeout(() => {
                if (result !== "OK") {
                    i.innerHTML = "Error Sending Request please try again";
                    o.innerHTML = "Pay via mpesa";
                } else {
                    i.innerHTML = `
                        <p class='alert alert-success m0 success'>
                            Enter your mpesa pin on your phone then click on 'confirm payment' button below. 
                            If you cancel the request, retry again.
                        </p>`;
                    o.innerHTML = "Payment initiated click confirm button";
                }
            }, 5000);
        })
        .catch(error => {
            i.innerHTML = "<p class='alert alert-danger m0' style='padding:20px; border-radius:5px; border: 1px solid'>Payment Failed.</p>";
            o.innerHTML = "Pay via mpesa";
        });
    }
});
</script>





