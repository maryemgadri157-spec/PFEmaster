// });

// Close results if user clicks outside
document.addEventListener('click', (e) => {
    if (!document.getElementById('searchArea').contains(e.target)) {
        resultsBox.style.display = 'none';
    }
});

    // 2. Mobile Menu Slider Logic
    const offcanvasBody = document.querySelector('.offcanvas-body');
    document.querySelectorAll('.js-drill-down').forEach(btn => {
        btn.onclick = function() {
            if (window.innerWidth < 992) {
                this.closest('.nav-item-static').querySelector('.mega-panel').classList.add('is-visible');
                offcanvasBody.classList.add('menu-slider-active');
            }
        };
    });
    document.querySelectorAll('.js-back-btn').forEach(btn => {
        btn.onclick = function() {
            this.closest('.mega-panel').classList.remove('is-visible');
            offcanvasBody.classList.remove('menu-slider-active');
        };
    });

    // Hide search results when clicking outside
    document.addEventListener('click', (e) => {
        if (!document.getElementById('searchArea').contains(e.target)) resultsBox.style.display = 'none';
    });
</script>




<script>
    $(document).ready(function() {
  $(".show-more a").on("click", function() {
    var $this = $(this); 
    var $content = $this.parent().prev("div.hidencontent");
    var linkText = $this.text().toUpperCase();    

    if (linkText === "SHOW MORE") {
      linkText = "Show less";
      $content.removeClass("hideContent");
      $content.addClass("showContent");
    } else {
      linkText = "Show more";
      $content.removeClass("showContent");
      $content.addClass("hideContent");
    };

    $this.text(linkText);
  });
});
</script>

