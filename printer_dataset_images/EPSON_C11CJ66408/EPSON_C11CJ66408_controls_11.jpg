document.addEventListener('DOMContentLoaded', function () {

  const input = document.getElementById('bookme');
  const resultDropdown = document.getElementById('book-result');

  let debounceTimer;

  input.addEventListener('keyup', function () {
    clearTimeout(debounceTimer);

    const inputVal = this.value.trim();

    if (inputVal.length < 2) {
      resultDropdown.innerHTML = '';
      resultDropdown.style.display = 'none';
      return;
    }

    debounceTimer = setTimeout(function () {

      fetch('https://rondamo.co.ke/search/', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
        },
        body: new URLSearchParams({
          ssk: inputVal
        })
      })
      .then(response => response.text())
      .then(data => {

        if (!data || data.trim() === '') {
          resultDropdown.style.display = 'none';
          return;
        }

        // ✅ EXACT requirement
        resultDropdown.innerHTML = data;
        resultDropdown.style.display = 'block';
      })
      .catch(() => {
        resultDropdown.style.display = 'none';
      });

    }, 300);
  });

  // Hide when clicking outside
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.header-search-el-wrap')) {
      resultDropdown.style.display = 'none';
    }
  });

});



