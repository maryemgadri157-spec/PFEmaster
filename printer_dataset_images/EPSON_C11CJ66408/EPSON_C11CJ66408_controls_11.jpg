<style>

.result-wrap {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  z-index: 9999;
}

.book-result {
  background: #fff;
  border-radius: 10px;
  margin-top: 6px;
  box-shadow: 0 10px 25px rgba(0,0,0,.15);
  max-height: 400px;
  overflow-y: auto;
  display: none;
}



.suggest-book-wrap a{
    font-size:16px;
}
.suggest-book-wrap a {
    font-size: 16px;
    color: #000;
}



@media only screen and (min-width: 600px) {
  .logmd{
    height: 71px;
}
}
@media only screen and (max-width: 600px) {
  .logmd{
   height: 55px;
}
}
.product-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: all 0.25s ease;
}

.product-card:hover .product-title {
    white-space: normal;
    overflow: visible;
    text-overflow: unset;
}
.h5, h5 {
    font-size: 1.05rem;
}

.product-card .price-wrap {
    background-color: #e6eefa;
    display: flex;
    padding: .5rem;
    border-radius: .25rem;
    justify-content: center;
    align-items: center;
}
.add-to-basketl {
    --bs-btn-border-color: #75973d;
    --bs-btn-hover-color: #fff;
    --bs-btn-border-width: 1px;
    --bs-btn-hover-color: #fff;
    --bs-btn-hover-bg: rgb(99.45, 128.35, 51.85);
    --bs-btn-hover-border-color: rgb(93.6, 120.8, 48.8);
    background: #75973d;
    box-shadow: 0 2px 2px rgba(0, 0, 0, .14), 0 3px 1px -2px rgba(0, 0, 0, .2), 0 1px 5px rgba(0, 0, 0, .12);
    border: var(--bs-btn-border-width) solid var(--bs-btn-border-color);
    
}
.add-to-basketl:hover{
    background: var(--bs-btn-hover-bg);
    border: var(--bs-btn-border-width) solid var(--bs-btn-hover-border-color);
}

</style>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root { --j-orange: #f68b1e; --amazon-blue: #232f3e; }
        body { background-color: #f8f9fa; font-family: 'Inter', system-ui, -apple-system, sans-serif; }

        /* --- Header & Nav Styles --- */
        .nav-link-top { font-size: 12px; color: #ced4da; text-decoration: none; transition: 0.2s; }
        .nav-link-top:hover { color: #fff; }
        .hover-orange:hover { color: var(--j-orange) !important; }
        
        /* --- Search Dropdown --- */
        .search-results { z-index: 3000; top: 100%; left: 0; right: 0; display: none; background: white; max-height: 450px; overflow-y: auto; }
        
        /* --- Mega Menu (Desktop) --- */
        @media (min-width: 992px) {
            .mega-panel {
                display: none; 
                position: absolute; top: 0; left: 100%;
                width: 800px; min-height: 100%; background: white;
                z-index: 1060; border-left: 1px solid #eee;
                box-shadow: 20px 0 40px rgba(0,0,0,0.1); padding: 2rem;
            }
            .nav-item-static:hover .mega-panel { display: block; }
            .mega-panel-content { column-count: 3; column-gap: 2rem; }
            .mega-panel-section { display: inline-block; width: 100%; break-inside: avoid; margin-bottom: 1.5rem; }
        }

        /* --- Mobile Drill-Down Logic --- */
        @media (max-width: 991px) {
            .mega-panel {
                 display: none; 
                position: absolute; top: 0; left: 100%; width: 100%; height: 100%;
                background: white; z-index: 2000; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                overflow-y: auto;
            }
            .menu-slider-active .mega-panel.is-visible {  display: block; transform: translateX(-100%); }
        }

        .text-orange { color: var(--j-orange) !important; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        
        /* Container for the logo to ensure vertical alignment */
.navbar-brand {
    display: flex;
    align-items: center;
    padding: 0;
    margin: 0;
    height: 100%;
}

/* Core Logo Styling */
.main-logo-img {
    height: 50px;           /* Standard height for Desktop */
    width: auto;            /* Maintain aspect ratio */
    object-fit: contain;    /* Ensure image isn't cropped */
    image-rendering: -webkit-optimize-contrast; /* Keeps logo sharp */
    transition: transform 0.3s ease; /* Smooth hover effect */
}

/* Mobile Adjustments (Phones) */
@media (max-width: 768px) {
    .main-logo-img {
        height: 35px;       /* Slimmer height for mobile headers */
    }
}

/* Tablet Adjustments */
@media (min-width: 769px) and (max-width: 991px) {
    .main-logo-img {
        height: 40px;
    }
}

/* Optional: Subtle hover lift */
.navbar-brand:hover .main-logo-img {
    transform: translateY(-1px);
}
    </style>

