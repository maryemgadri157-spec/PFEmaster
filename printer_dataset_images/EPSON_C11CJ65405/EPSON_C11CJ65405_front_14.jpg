<style type="text/css">
.py-100 {
  padding: 100px 0;
}

body {
  scroll-behavior: smooth;
}

.fs-section {
  color: white;
}

.fs-step {
  padding: 80px 0;
}

.fs-step--init {
  background-color: #4A4E51;
}

.fs-step--cat {
  display: none;
}

.fs-step--cat.active {
  display: block;
  background-color: #777B84;
  position: relative;
}

.fs-step--cat.active::before {
  content: "";
  background-image: url(https://epsonemear.a.bigcontent.io/v1/static/robots_1123_product_triangle_grey_dark);
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  width: 60px;
  height: 40px;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

.fs-step--res {
  display: none;
}

.fs-step--res.active {
  display: block;
  background-color: #90949C;
  position: relative;
}

.fs-step--res.active::before {
  content: "";
  background-image: url(https://epsonemear.a.bigcontent.io/v1/static/robots_1123_product_triangle_grey_medium);
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  width: 60px;
  height: 40px;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

.fs-section h2 {
  font-size: 40px;
  color: white;
  text-align: center;
  margin-bottom: 41px;
}

.fs-section p {
  font-size: 16px;
  text-align: center;
  margin-bottom: 76px;
}

.fs-btn-link {
  font-weight: bold;
  text-transform: uppercase;
  color: white;
  background: none;
  border: none;
}

.fs-btn-link:hover {
  text-decoration: underline;
}

.fs-items {
  display: flex;
  width: 100%;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
}

.fs-items--feat {
  flex-direction: column;
  gap: 0;
  margin-top: 15px;
}

.fs-items--feat .featline {
  font-size: 20px;
  font-weight: bold;
  background-color: #6B6E77;
  text-align: center;
  padding: 24px;
}

.fs-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 41px 25px 33px;
  position: relative;
  transition: 0.4s ease-out;
  width: 100%;
  max-width: calc(50% - 7.5px);
  cursor: pointer;
}
.fs-item.link a:hover, .fs-item.link a:focus {
  color: white;
}

#accessories .fs-item, #seriesItems .fs-item {
  cursor: default;
}

@media (max-width: 991px) {
  .fs-item {
    max-width: 100%;
  }
}
.fs-items--feat .fs-item {
  max-width: 100%;
}

.fs-item p {
  font-size: 16px;
  max-width: 400px;
  margin: 0 auto;
}

.fs-step--init .fs-item {
  background-color: #5C6063;
}

.fs-step--init .fs-item:hover {
  background-color: #6E7174;
}

.fs-step--cat .fs-item {
  padding: 70px 25px 33px;
  background-color: #858891;
}

.fs-step--cat .fs-item:hover {
  background-color: #92959D;
}

.fs-step--res .fs-item {
  background-color: #9B9FA6;
}

.fs-step--res .fs-item:hover {
  background-color: #A6A9B0;
}

.fs-item.selected::after {
  content: "";
  background-image: url(https://epsonemear.a.bigcontent.io/v1/static/robots_1123_product_circle_selected);
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  width: 38px;
  height: 38px;
  position: absolute;
  top: 61px;
  right: 45px;
}

.fs-item .leveltag {
  opacity: 0.5;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
  position: absolute;
  top: 25px;
  text-align: center;
}

.fs-item img {
  display: block;
  height: 267px;
  margin-bottom: 16px;
  transition: 0.4s ease-out;
  pointer-events: none;
}

.fs-item:hover img {
  transform: scale(1.1);
}

.fs-item p {
  padding: 16px 0 43px;
  pointer-events: none;
}

.fs-ping-link {
  color: white;
  text-decoration: none;
}

.fs-ping-link:hover {
  color: white;
  text-decoration: underline;
}

.fs-ping-link:visited {
  color: white;
  text-decoration: none;
}

.fs-ping {
  position: absolute;
  top: 55px;
  left: 25px;
  width: 69px;
  height: 69px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #F68F38;
  line-height: 1.2;
  transition: all 0.3s ease-in-out;
  z-index: 20;
}

.fs-ping:hover {
  transform: scale(1.1);
}

.fs-item h3 {
  pointer-events: none;
}
</style>
