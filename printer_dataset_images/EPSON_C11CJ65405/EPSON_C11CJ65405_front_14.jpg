<section class="service" data-section="service" id="service">
    <div class="tabs-intro-nav amp-bg-colour amp-bg-colour--white">
        <h1 class="service__heading no-margin-top">Service centre</h1>
        <ul class="service__tabs amp-bg-colour--light-grey">
            <li class="service__tab-link current" data-tab="tab-1" style="width: 100%; display: inline-block">
                <div>
                    <span class="service__icon service__tab-icon-1">&nbsp;</span>
                    <span>Technical Support</span>
                </div>
            </li>
            <li class="service__tab-link" data-tab="tab-2" style="width: 100%; display: inline-block">
                <div>
                    <span class="service__icon service__tab-icon-2">&nbsp;</span>
                    <span>Service</span>
                </div>
            </li>
            <li class="service__tab-link" data-tab="tab-3" style="width: 100%; display: inline-block">
                <div>
                    <span class="service__icon service__tab-icon-3">&nbsp;</span>
