    series['cSeries'] = cSeries;
    series['cxSeries'] = cxSeries;
    series['nSeries'] = nSeries;
    
    const scrollToElement = function (node, offset, isSmooth) {
        offset = offset || 0
        isSmooth = typeof isSmooth === 'undefined' ? true : isSmooth
        offset = node.getBoundingClientRect().top + window.pageYOffset + offset
        const options = { top: offset, left: 0 }
        if (isSmooth) options.behavior = 'smooth'
        scroll(options)
    }
    
    // const populate = () => {
    
    //     generateHTML(tbSeries,);
    // }
    
    document.addEventListener('DOMContentLoaded', () => {
    
        
        const findSolution = document.getElementById('findSolution');
        const initStepItemBtns = document.querySelectorAll('.fs-step--init .fs-btn-link');
        const catsStepItemBtns = document.querySelectorAll('.fs-step--cat .fs-btn-link');
        const selectedCats = document.querySelectorAll('.fs-step--cat');
        
        const seriesHeading = document.getElementById('seriesHeading');
        const seriesDesc = document.getElementById('seriesDesc');
        const seriesItems = document.getElementById('seriesItems');
        const fsResults = document.getElementById('fsResults');
    
    
        initStepItemBtns.forEach(itemBtn => {
        
        itemBtn.closest('.fs-item').addEventListener('click', e => {
            e.preventDefault();
            if (e.target.classList.contains('link')) {

                    const url = e.target.querySelector('a') ? e.target.querySelector('a').href : e.target.href;
                    open(url, '_blank');
                } else {
            initStepItemBtns.forEach(btn => {
                if (btn != e.target && btn.closest('.fs-item') != e.target || e.target.innerText.toLowerCase() === 'unselect') {
                    btn.closest('.fs-item').classList.remove('selected');
                    btn.innerText = 'Select';
                    selectedCats.forEach(cat => {
                        cat.classList.remove('active');
                        fsResults.classList.remove('active');
                        seriesHeading.innerHTML = '';
                        seriesDesc.innerHTML = '';
                        seriesItems.innerHTML = '';
                    })
                } else {
                    e.target.closest('.fs-item').classList.add('selected');
                    if(e.target.querySelector('.fs-btn-link')) {
                        e.target.querySelector('.fs-btn-link').innerText = 'Unselect';
                    } else {
                        e.target.innerText = 'Unselect';
                    }

                }
            });

            selectedCats.forEach(cat => {
                if (e.target.dataset.target) {
                    if (cat.dataset.cat == e.target.dataset.target && e.target.innerText.toLowerCase() != 'select') {
                    console.log("running");
                    if (!document.querySelectorAll('.fs-step--cat.active').length) {
                        cat.classList.add('active');
                        scrollToElement(cat, 0);
                    } else {
                        cat.classList.add('active');
                    }
                } else {
                    console.log(e);
                    cat.classList.remove('active');
                }
                } else if (cat.dataset.cat == e.target.children[3].dataset.target && e.target.children[3].innerText.toLowerCase() != 'select') {
                    if (cat.dataset.cat == e.target.children[3].dataset.target && e.target.children[3].innerText.toLowerCase() != 'select') {
                        if (!document.querySelectorAll('.fs-step--cat.active').length) {
                            cat.classList.add('active');
                            scrollToElement(cat, 0);
                        } else {
                        cat.classList.add('active');
                        }
                    }
                }

            });
        }
        })
    });

    catsStepItemBtns.forEach(catBtn => {

        catBtn.closest('.fs-item').addEventListener('click', e => {
            if (e.srcElement.matches('.fs-ping, .fs-ping div')) {
                return
            }
            else {
            e.preventDefault();
            catsStepItemBtns.forEach(btn => {
                console.log(e);
                if (btn != e.target && btn.closest('.fs-item') != e.target || e.target.innerText.toLowerCase() === 'unselect') {
                    btn.closest('.fs-item').classList.remove('selected');
                    btn.innerText = 'Select';
                } else {
                    btn.closest('.fs-item').classList.add('selected');
                    btn.innerText = 'Unselect';
                }
            });

            const currentSeries = document.querySelector('.fs-step--cat .selected .fs-btn-link');

            if (currentSeries) {
                fsResults.classList.add('active');
                
                const data = series[currentSeries.dataset.target];
                if (data) {

                    seriesHeading.innerHTML = data.heading;
                    seriesDesc.innerHTML = data.desc;
    
                    let itemsHTML = '';
                    data.items.forEach(item => {
    
                        let pingHTML = '';
                        if (item.ping && item.ping != '') pingHTML =   `<a href="/en_EU/robots/safety-functions" class="fs-ping-link"><div class="fs-ping">${item.ping}</div></a>`;
                        if (item.url && item.url != '') urlHTML =  `<a href="${item.url}" class="btn btn-primary" target="_blank">Learn more</a>`;
                        const itemHTML = 
                            `<div class="fs-item">
                                ${pingHTML}
                                <img src="${item.img}" alt="${item.name}">
                                <h3>${item.name}</h3>
                                <p>${item.desc}</p>
                                ${urlHTML}
                            </div>`;
                        
                        itemsHTML += itemHTML;
                    });
    
                    seriesItems.innerHTML = itemsHTML;
                    scrollToElement(fsResults, 0);

                } else {

                    fsResults.classList.remove('active');
                    seriesHeading.innerHTML = '';
                    seriesDesc.innerHTML = '';
                    seriesItems.innerHTML = '';
                }

            } else {
                fsResults.classList.remove('active');
                seriesHeading.innerHTML = '';
                seriesDesc.innerHTML = '';
                seriesItems.innerHTML = '';
            }
        }
        });
    });

    let accessoriesItems = '';
    accessories.items.forEach(item => {
        let pingHTML = '';
        let urlHTML = '';
        if (item.ping && item.ping != '') pingHTML =   `<a href="/en_EU/robots/safety-functions" class="fs-ping-link"><div class="fs-ping">${item.ping}</div></a>`;
        if (item.url && item.url != '') urlHTML =  `<a href="${item.url}" class="btn btn-primary" target="_blank">Learn more</a>`;
        const itemHTML = 
            `<div class="fs-item">
                ${pingHTML}
                <img src="${item.img}" alt="${item.name}">
                <h3>${item.name}</h3>
                <p>${item.desc}</p>
                ${urlHTML}
            </div>`;

        accessoriesItems += itemHTML;
    })
    
    const accessoriesHTML = 
    `<h2>${accessories.heading}</h2>
    <p>${accessories.desc}</p>
    <div class="fs-items">${accessoriesItems}</div>`;
    
    const el = document
    .getElementById('accessories');
    el.innerHTML = accessoriesHTML;

    const paramsString = window.location.search;
        const searchParams = new URLSearchParams(paramsString);
        if(searchParams.get("scara") === 'open') {
                document.getElementById('scara').click();
                scrollToElement(document.querySelector('div[data-cat=c1]'));
        } 
});
