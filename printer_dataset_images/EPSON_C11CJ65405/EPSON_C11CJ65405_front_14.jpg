<div class="amplience-component js-amplience-component" id="3df3d8ff-194d-4eef-917b-4d1db7cbb0d1">
            <div class="amp-component js-tab-panel-section" data-section="768b99da-f890-42eb-a47d-ab2041a5c5eb" id="768b99da-f890-42eb-a47d-ab2041a5c5eb">
        <div class="amp-html">
    <!-- <link rel="stylesheet" href="https://www.epson.co.uk/_ui/responsive/theme-alpha/css/style.css?20230807.2"> -->
<style type="text/css">
    .xgn-fixed-banner-items {
        display: flex;
        width: inherit;
        justify-content: center;
        padding-top: 5px;
        padding-bottom: 5px;
        gap: 20px;
    }
    .xgn-banner-item {
        display: flex;
        flex-direction: row;
        gap: 15px;
        flex-basis: 0;
        align-items: center;
        justify-content: start;
    }
    .xgn-banner-item--small {
        flex-grow: 1;
        justify-content: end;
    }
    .xgn-banner-item--large {
        flex-grow: 1;
        justify-content: start;
    }
    .sticky-yms {
        position: -webkit-sticky; 
        position: sticky; 
        top: 0;
        background: white;
        z-index: 10;
    }
    .sticky-yms--nav-stuck {
        top: 75px;
    }
    
    .search-site {
        z-index: 11 !important;
    }
    
    @media (max-width: 1023px) {
        .xgn-fixed-banner-items {
            flex-direction: column;
        }
        .xgn-fixed-banner-item {
            flex-basis: 100%;
        }
        .sticky-yms--nav-stuck {
        top: 55px;
        }
        .xgn-banner-item--small {
            justify-content: center;
        }
        .xgn-banner-item--large {
            justify-content: center;
        }
    }
    @media (max-width: 500px) {
        .xgn-banner-item {
            flex-direction: column;
            flex-basis: 100%;
        }
        .xgn-banner-item a {
            width: 100%;
        }
        .xgn-banner-item--small {
        flex-grow: 1;
        }
        .xgn-banner-item--large {
            flex-grow: 1;
        }
    }
    
</style>

<div class="xgn-fixed-banner amp-bg-colour--white">
    <div class="amp-content__container">
        <div class="xgn-fixed-banner-items">
            <div class="xgn-banner-item xgn-banner-item--small">
                <span class="amp-body-large">Discover our free Epson Robotics downloads.</span>
            </div>
            <div class="xgn-banner-item xgn-banner-item--large">
                <a class="btn btn-primary" href="https://epsonemear.a.bigcontent.io/v1/static/a25992-brochure-hires-en_int-robots_brochure_2026" target="_blank">Product catalogue</a>
                <a class="btn btn-primary" href="https://epsonemear.a.bigcontent.io/v1/static/a24573-flyer-hires-en-int-robotics_overview_card_a5_single-page" target="_blank">Range overview</a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        let bannerContainer = document.querySelector(".xgn-fixed-banner").closest(".yCmsContentSlot");
        bannerContainer.classList.add("sticky-yms");
        document.addEventListener('scroll', () => {
            if (document.querySelector(".tab-panel__tab-bar--pinned")) {
                if (!bannerContainer.classList.contains("sticky-yms--nav-stuck")) {
                    bannerContainer.classList.add("sticky-yms--nav-stuck");
                }
            } else {
                bannerContainer.classList.remove("sticky-yms--nav-stuck");
            }
        })

        function isInViewport(element) {
            const rect = element.getBoundingClientRect();
            return (
                rect.top >= 0 &&
                rect.left >= 0 &&
                rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
                rect.right <= (window.innerWidth || document.documentElement.clientWidth)
            );
        }

        document.addEventListener("scroll", () => {
            let search = document.querySelector(".search-site");
            if (search.style.display == 'block' && !isInViewport(search)) {
                search.style.display = "none";
            }
        });
    });
</script>
